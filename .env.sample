# Qwen3.8-Flash-Next NVFP4 on 3x RTX 4090 48GB
# Copy to .env and edit paths / ports / API key.
# .env is git-ignored. Never commit real keys.

# ---- model ----------------------------------------------------------------
# Set this to the checkpoint you are authorized to use. The recipe expects
# the NVFP4 layout described in docs/compatibility.md.
MODEL_ID="<your-gated-checkpoint>"
MODEL_REVISION="master"
MODEL_DIR="$HOME/models/Qwen3.8-Flash-Next-NVFP4"
FP8HYBRID_DIR="$HOME/models/Qwen3.8-Flash-Next-NVFP4-fp8hybrid"
MTP_FP8_DIR="$HOME/models/Qwen3.8-Flash-Next-NVFP4-mtp-fp8hybrid"

# Default production checkpoint: FP8 side layers + FP8 MTP experts.
MODEL_PATH="$MTP_FP8_DIR"

# ---- runtime --------------------------------------------------------------
VENV="$HOME/vllm-venv"
VLLM_VERSION="0.30.0"
GPU_IDS="0,1,2"
TP_SIZE=3

# ---- server ---------------------------------------------------------------
# Safe default: loopback only. For LAN access, set BIND_HOST=0.0.0.0 AND an
# API key (or explicitly ALLOW_INSECURE=1 on a trusted network).
BIND_HOST="127.0.0.1"
PORT=12345
SERVED_MODEL_NAME="qwen38-flash-next-nvfp4"
API_KEY_FILE=""
ALLOW_INSECURE=0

# ---- tuning ---------------------------------------------------------------
MTP_K=2
MAX_MODEL_LEN=524288
MAX_NUM_SEQS=16
GPU_MEM_UTIL=0.96
YARN_FACTOR=2.0
KV_CACHE_DTYPE="fp8_e4m3"

# ---- download -------------------------------------------------------------
# modelscope | hf
DOWNLOAD_SOURCE="modelscope"
HF_TOKEN=""
PAR=6

# ---- paths ----------------------------------------------------------------
LOG_DIR="$HOME/.local/state/qwen38-flash-next"